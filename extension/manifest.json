{
  "manifest_version": 3,
  "name": "BBReader · 南科大课件与作业",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "课件按需下载归档、作业日程与日历订阅。每天定时更新课程与课件索引（默认校园时间 09:00，可调整）。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "downloads",
    "offscreen",
    "scripting"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://bb.sustech.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 BBReader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "index.html",
  "key": "",
  "optional_host_permissions": [
    "https://cas.sustech.edu.cn/*"
  ]
}
